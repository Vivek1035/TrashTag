# TrashTag Backend Environment Variables
# Copy this file to .env and fill in the values.
# NEVER commit .env to version control.

# ── PostgreSQL ──────────────────────────────────────────────────
POSTGRES_URL=jdbc:postgresql://localhost:5432/trashtag
POSTGRES_USERNAME=trashtag_user
POSTGRES_PASSWORD=change_me

# ── MongoDB ─────────────────────────────────────────────────────
MONGODB_URI=mongodb://trashtag_mongo_user:change_me@localhost:27017/trashtag?authSource=admin

# ── JWT ─────────────────────────────────────────────────────────
# Must be at least 256 bits (32 characters). Use a cryptographically random value.
JWT_SECRET=change_me_to_a_secure_random_256bit_string

# ── Cloudinary ──────────────────────────────────────────────────
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# ── AI Provider ─────────────────────────────────────────────────
# Set AI_PROVIDER to "gemini", "openai", or "mock" (default: mock)
AI_API_KEY=your_ai_api_key
AI_API_URL=https://generativelanguage.googleapis.com/v1beta/models/gemini-pro:generateContent

# ── Spring Profile ───────────────────────────────────────────────
SPRING_PROFILES_ACTIVE=dev

